set -euo pipefail
[[ -z ${TRACE:-} ]] || set -x

if [[ ${1:--h} == -h || ${1:-} == --help || $# -lt 3 ]]; then
    echo 'Usage: manyclangs-run ELFSHAKER_DIRECTORY COMMITISH TOOL [ARGS...]'
    echo 'Resolve COMMITISH in the current Git checkout, extract, link, and run TOOL.'
    echo 'Set USE_DOCKER_QEMU=aarch64 to link/run in manyclangs-qemu-aarch64.'
    echo 'Lookup, extraction and linking failures return 125; tool status is preserved.'
    echo 'Refresh the catalog separately with elfshaker update.'
    [[ $# == 0 || ${1:-} == -h || ${1:-} == --help ]] && exit 0
    exit 2
fi

repo=$(cd "$1" && pwd) || exit 125
sha=$(git rev-parse --short=10 --verify --end-of-options "$2^{commit}") || exit 125
tool=$(basename -- "$3")
shift 3
cd "$repo" || exit 125

# Shell code is fixed; caller-supplied values are passed as separate arguments.
link_and_run='mkdir -p bin || exit 125; bash ./link.sh "$1" >&2 || exit 125; tool=$1; shift; exec "./bin/$tool" "$@"'
if [[ ${USE_DOCKER_QEMU:-} == aarch64 ]]; then
    docker image inspect manyclangs-qemu-aarch64 >/dev/null 2>&1 || {
        echo 'Build the manyclangs-qemu-aarch64 Docker image first; see contrib/README.md.' >&2
        exit 125
    }
    exec elfshaker run --verify "$sha" -- docker run --rm \
        --mount "type=bind,source=$repo,target=/elfshaker" \
        manyclangs-qemu-aarch64 bash -c "$link_and_run" manyclangs "$tool" "$@"
fi
exec elfshaker run --verify "$sha" -- bash -c "$link_and_run" manyclangs "$tool" "$@"
